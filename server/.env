# ------------------------------------------------------------------
# Copie para .env e preencha. Nenhuma destas chaves vai para o frontend.
# ------------------------------------------------------------------

PORT=3000

# Caminho do banco SQLite (é criado sozinho na primeira execução)
DB_PATH=./data/agenda.db

# Origens permitidas para chamar a API (separadas por vírgula).
# Em produção, coloque o domínio final. Vazio = mesma origem apenas.
ALLOWED_ORIGINS=

# Cookie de sessão do /admin em HTTPS. Deixe false só em desenvolvimento local.
SECURE_COOKIES=true

# Máximo de tentativas de agendamento por IP, por hora
RATE_LIMIT_AGENDAR=15

# ------------------------------------------------------------------
# Dados da profissional — usados pelo `npm run seed` na primeira carga.
# Trocar aqui e rodar o seed de novo NÃO sobrescreve dados já existentes.
# ------------------------------------------------------------------
TENANT_SLUG=adriana-cabral
TENANT_NAME=Adriana Cabral
TENANT_TIMEZONE=America/Sao_Paulo
TENANT_WHATSAPP=(16)99619-2955
TENANT_SITE=https://adriana-cabral.onrender.com/
DB_PATH=/opt/render/project/data/agenda.db

# Acesso ao painel /admin (a senha é gravada apenas como hash scrypt)
ADMIN_EMAIL=jess.silvasp1@gmail.com
ADMIN_PASSWORD=Senhatest123
